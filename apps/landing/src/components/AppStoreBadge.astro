---
// "Download on the App Store" badge, built in markup rather than as an image so
// the label localizes with the rest of the copy and stays crisp at any size.
// Apple's official artwork lives at developer.apple.com/app-store/marketing/guidelines —
// swap this for the official SVG if you ever need pixel-exact brand compliance.
import type { Copy } from '../i18n/types';
import { appStoreUrl } from '../i18n/utils';

interface Props {
  copy: Copy;
  class?: string;
}
const { copy, class: className } = Astro.props;
const { appStore } = copy;
---

<a
  href={appStoreUrl}
  class:list={['badge', className]}
  aria-label={appStore.ariaLabel}
>
  <svg class='apple' viewBox='0 0 384 512' aria-hidden='true' focusable='false'>
    <path
      fill='currentColor'
      d='M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z'
    ></path>
  </svg>
  <span class='labels'>
    <span class='small'>{appStore.badgeSmall}</span>
    <span class='large'>{appStore.badgeLarge}</span>
  </span>
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1.25rem 0.6875rem;
    border-radius: 9999px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    line-height: 1;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      opacity 0.15s ease;
    box-shadow: 0 6px 20px -8px
      color-mix(in oklch, var(--color-foreground) 55%, transparent);
  }
  .badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 28px -8px
      color-mix(in oklch, var(--color-foreground) 65%, transparent);
  }
  .badge:active {
    transform: translateY(0);
  }

  .apple {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    /* The glyph's optical centre sits below its bounding box centre. */
    margin-top: -0.125rem;
  }

  .labels {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    text-align: left;
  }
  .small {
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }
  .large {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
